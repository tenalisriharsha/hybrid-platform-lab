spring:
  application:
    name: platform-api

server:
  port: {{ platform_config_api_port }}

management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      show-details: when-authorized
  metrics:
    tags:
      application: ${spring.application.name}

logging:
  level:
    root: {{ platform_config_logging_level_root }}
    dev.hybridplatform: {{ platform_config_logging_level_platform }}

info:
  app:
    name: Hybrid Platform Lab — platform-api
    environment: "{{ platform_config_env }}"
